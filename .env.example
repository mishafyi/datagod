# DataGod environment — copy to .env and fill in. Only DATAGOD_API_KEY is
# required for the service to start; per-source keys unlock the sources that
# need them. NEVER commit your real .env (it is git-ignored).
#
# Keep comments on their own lines: an inline "# …" after a blank value is
# read as the value itself (python-dotenv), and `docker run --env-file` keeps
# every inline comment as part of the value. A blank value means "unset", so
# the DEMO_KEY fallbacks below apply.

# ── DataGod's own auth ────────────────────────────────────────────
# Gates every endpoint via the X-API-Key header. Generate: openssl rand -hex 32
DATAGOD_API_KEY=

# Interactive docs (/docs, /redoc, /openapi.json) HTTP Basic auth.
# Optional — username defaults to "datagod" and the password falls back to
# DATAGOD_API_KEY when DATAGOD_DOCS_PASSWORD is unset.
DATAGOD_DOCS_USER=datagod
DATAGOD_DOCS_PASSWORD=

# ── Upstream source keys ──────────────────────────────────────────
# Required by SEC EDGAR — format: "Name email@example.com"
SEC_USER_AGENT=
# Required for FRED
FRED_API_KEY=
# Required for Census (keyless requests now 302 to a Missing-Key page)
CENSUS_API_KEY=
# Optional — switches BLS to the v2 API (higher limits, 20-year spans)
BLS_API_KEY=
# Optional — falls back to DEMO_KEY
FEC_API_KEY=
# Optional — falls back to DEMO_KEY
CONGRESS_API_KEY=
# Optional — falls back to DEMO_KEY
EIA_API_KEY=
# Optional — falls back to DEMO_KEY
SMITHSONIAN_API_KEY=
# Optional (SAM.gov; not yet wired to a client)
SAM_API_KEY=
# Required for /ucdp since 2026 — free registration at ucdp.uu.se (upstream 401s without it)
UCDP_ACCESS_TOKEN=
# Optional (api.data.gov)
DATAGOV_API_KEY=
# Required for /trending — self-hosted newsnow instance (github.com/ourongxing/newsnow),
# e.g. http://newsnow:4444
NEWSNOW_BASE_URL=
