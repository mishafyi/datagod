# DataGod environment — copy to .env and fill in. Only DATAGOD_API_KEY is
# required for the service to start; per-source keys unlock the sources that
# need them. NEVER commit your real .env (it is git-ignored).

# ── DataGod's own auth ────────────────────────────────────────────
# Gates every endpoint via the X-API-Key header. Generate: openssl rand -hex 32
DATAGOD_API_KEY=

# Interactive docs (/docs, /redoc, /openapi.json) HTTP Basic auth.
# Optional — username defaults to "datagod" and the password falls back to
# DATAGOD_API_KEY when DATAGOD_DOCS_PASSWORD is unset.
DATAGOD_DOCS_USER=datagod
DATAGOD_DOCS_PASSWORD=

# ── Upstream source keys ──────────────────────────────────────────
SEC_USER_AGENT=          # required by SEC EDGAR — format: "Name email@example.com"
FRED_API_KEY=            # required for FRED
CENSUS_API_KEY=          # required for Census (keyless requests now 302 to a Missing-Key page)
BLS_API_KEY=             # optional (higher rate limits)
FEC_API_KEY=             # optional — falls back to DEMO_KEY
CONGRESS_API_KEY=        # optional — falls back to DEMO_KEY
EIA_API_KEY=             # optional — falls back to DEMO_KEY
SMITHSONIAN_API_KEY=     # optional — falls back to DEMO_KEY
SAM_API_KEY=             # optional (SAM.gov; not yet wired to a client)
UCDP_ACCESS_TOKEN=       # required for /ucdp since 2026 — free registration at ucdp.uu.se (upstream 401s without it)
DATAGOV_API_KEY=         # optional (api.data.gov)
NEWSNOW_BASE_URL=        # required for /trending — self-hosted newsnow instance (github.com/ourongxing/newsnow), e.g. http://newsnow:4444
